# Copie este arquivo para ".env" e troque os valores. O ".env" NAO vai para o Git.
#   Copy-Item .env.example .env          (PowerShell)
#   docker compose up --build

# Senha do usuario "sa" do SQL Server (minimo 8 caracteres, com maiuscula, minuscula, numero e simbolo)
SA_PASSWORD=Troque-Esta-Senha-123!

# Chave que assina os tokens JWT (minimo 32 caracteres). Gere uma aleatoria, por exemplo:
#   [Convert]::ToBase64String((1..48 | % { Get-Random -Maximum 256 }) -as [byte[]])
JWT_KEY=troque-por-uma-chave-aleatoria-com-mais-de-32-caracteres

# Endereco publico do site (usado para mostrar as fotos do cardapio no admin)
SITE_URL=http://localhost:5500/

# Porta em que a API fica disponivel no seu computador
PORTA_API=8080
