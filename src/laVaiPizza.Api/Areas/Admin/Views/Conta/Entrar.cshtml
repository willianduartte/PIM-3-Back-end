@model EntrarViewModel
@{
    ViewData["Title"] = "Entrar";
}

<div class="row justify-content-center">
    <div class="col-12 col-sm-10 col-md-6 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-1">Área da equipe</h1>
                <p class="text-secondary">Entre com o e-mail e a senha de funcionário.</p>

                <form method="post" asp-area="Admin" asp-controller="Conta" asp-action="Entrar" novalidate>
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" type="email" autocomplete="username" autofocus required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Senha" class="form-label"></label>
                        <input asp-for="Senha" class="form-control" autocomplete="current-password" required />
                        <span asp-validation-for="Senha" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-lavai w-100">Entrar</button>
                </form>
            </div>
        </div>
    </div>
</div>
