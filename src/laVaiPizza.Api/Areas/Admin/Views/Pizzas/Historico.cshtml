@model HistoricoPrecosViewModel
@{
    ViewData["Title"] = "Histórico de preços";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Histórico de preços</h1>
    <a class="btn btn-outline-secondary" asp-action="HistoricoCsv" asp-route-pizzaId="@Model.PizzaId">Baixar CSV</a>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-sm-6 col-md-4">
        <label for="pizzaId" class="form-label mb-1">Pizza</label>
        <select id="pizzaId" name="pizzaId" class="form-select">
            <option value="">Todas as pizzas</option>
            @foreach (var p in Model.Pizzas)
            {
                <option value="@p.Id" selected="@(Model.PizzaId == p.Id)">@p.Nome</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-lavai">Filtrar</button>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive" tabindex="0" role="region" aria-label="Tabela do histórico de preços (use as setas para rolar)">
        <table class="table table-hover align-middle mb-0">
            <caption class="visually-hidden">Alterações de preço, da mais recente para a mais antiga</caption>
            <thead class="table-light">
                <tr>
                    <th scope="col">Quando</th>
                    <th scope="col">Pizza</th>
                    <th scope="col">Tamanho</th>
                    <th scope="col" class="text-end">De</th>
                    <th scope="col" class="text-end">Para</th>
                    <th scope="col">Variação</th>
                    <th scope="col">Quem alterou</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Itens.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-secondary py-4">Nenhuma alteração de preço registrada.</td></tr>
                }
                @foreach (var h in Model.Itens)
                {
                    var subiu = h.PrecoNovo > h.PrecoAntigo;
                    var variacao = h.PrecoAntigo == 0 ? 0 : (h.PrecoNovo - h.PrecoAntigo) / h.PrecoAntigo * 100;
                    <tr>
                        <td>@Formatos.DataHora(h.AlteradoEm)</td>
                        <td>@h.Pizza</td>
                        <td>@h.Tamanho</td>
                        <td class="text-end">@Formatos.Moeda(h.PrecoAntigo)</td>
                        <td class="text-end">@Formatos.Moeda(h.PrecoNovo)</td>
                        <td>
                            <span class="badge @(subiu ? "text-bg-danger" : "text-bg-success")">
                                @(subiu ? "▲ aumento" : "▼ redução") @Formatos.Percentual(variacao)
                            </span>
                        </td>
                        <td>@(h.AlteradoPor ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
