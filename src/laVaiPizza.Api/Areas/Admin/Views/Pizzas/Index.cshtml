@model IReadOnlyList<PizzaAdminResponse>
@inject IOptions<SiteOptions> Site
@{
    ViewData["Title"] = "Pizzas";
    decimal? PrecoDe(PizzaAdminResponse p, string tamanho) => p.Precos.FirstOrDefault(x => x.Tamanho == tamanho)?.Preco;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Pizzas</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Historico">Histórico de preços</a>
        <a class="btn btn-lavai" asp-action="Nova">Nova pizza</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive" tabindex="0" role="region" aria-label="Tabela de pizzas (use as setas para rolar)">
        <table class="table table-hover align-middle mb-0">
            <caption class="visually-hidden">Pizzas cadastradas, com preço por tamanho e situação</caption>
            <thead class="table-light">
                <tr>
                    <th scope="col">Foto</th>
                    <th scope="col">Nome</th>
                    <th scope="col" class="text-end">Pequena</th>
                    <th scope="col" class="text-end">Média</th>
                    <th scope="col" class="text-end">Grande</th>
                    <th scope="col">Situação</th>
                    <th scope="col"><span class="visually-hidden">Ações</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    var foto = Formatos.UrlImagem(p.ImagemUrl, Site.Value.UrlBase);
                    <tr class="@(p.Ativa ? "" : "table-secondary")">
                        <td>
                            @if (foto != "")
                            {
                                <img src="@foto" alt="Foto de @p.Nome" class="miniatura" loading="lazy" />
                            }
                            else
                            {
                                <span class="text-secondary small">sem foto</span>
                            }
                        </td>
                        <td>
                            <div class="fw-semibold">@p.Nome</div>
                            <div class="small text-secondary descricao-curta">@p.Descricao</div>
                        </td>
                        <td class="text-end">@(PrecoDe(p, "Pequena") is { } a ? Formatos.Moeda(a) : "-")</td>
                        <td class="text-end">@(PrecoDe(p, "Media") is { } m ? Formatos.Moeda(m) : "-")</td>
                        <td class="text-end">@(PrecoDe(p, "Grande") is { } g ? Formatos.Moeda(g) : "-")</td>
                        <td>
                            @if (p.Ativa)
                            {
                                <span class="badge text-bg-success">No cardápio</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Desativada</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@p.Id">Editar</a>
                            @if (p.Ativa)
                            {
                                <form class="d-inline" method="post" asp-action="Desativar" asp-route-id="@p.Id"
                                      data-confirmar="Tirar &quot;@p.Nome&quot; do cardápio? O histórico de pedidos será mantido.">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Desativar</button>
                                </form>
                            }
                            else
                            {
                                <form class="d-inline" method="post" asp-action="Reativar" asp-route-id="@p.Id">
                                    <button type="submit" class="btn btn-sm btn-outline-success">Reativar</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<p class="text-secondary small mt-3">
    Pizzas nunca são apagadas: ao desativar, ela sai do cardápio mas continua nos pedidos antigos e nos relatórios.
</p>
