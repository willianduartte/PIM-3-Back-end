@model PizzaNovaViewModel
@{
    ViewData["Title"] = "Nova pizza";
}

<h1 class="h3 mb-3">Nova pizza</h1>

<div class="row">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-body">
                <form method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label"></label>
                        <input asp-for="Nome" class="form-control" maxlength="100" required />
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Descricao" class="form-label"></label>
                        <textarea asp-for="Descricao" class="form-control" rows="3" maxlength="300"></textarea>
                        <span asp-validation-for="Descricao" class="text-danger small"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-sm-4">
                            <label asp-for="PrecoPequena" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">R$</span>
                                <input asp-for="PrecoPequena" class="form-control" type="number" step="0.01" min="0.01" max="9999.99" required />
                            </div>
                            <span asp-validation-for="PrecoPequena" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-4">
                            <label asp-for="PrecoMedia" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">R$</span>
                                <input asp-for="PrecoMedia" class="form-control" type="number" step="0.01" min="0.01" max="9999.99" required />
                            </div>
                            <span asp-validation-for="PrecoMedia" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-4">
                            <label asp-for="PrecoGrande" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">R$</span>
                                <input asp-for="PrecoGrande" class="form-control" type="number" step="0.01" min="0.01" max="9999.99" required />
                            </div>
                            <span asp-validation-for="PrecoGrande" class="text-danger small"></span>
                        </div>
                    </div>

                    <p class="text-secondary small mt-3 mb-0">A foto é enviada depois de salvar.</p>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-lavai">Cadastrar pizza</button>
                        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
