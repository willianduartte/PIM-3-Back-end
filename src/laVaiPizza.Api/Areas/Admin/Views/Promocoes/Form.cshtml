@model PromocaoFormViewModel
@{
    var editando = Model.Id is not null;
    ViewData["Title"] = editando ? "Editar promoção" : "Nova promoção";
}

<h1 class="h3 mb-3">@ViewData["Title"]</h1>

<div class="row">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-body">
                <form method="post" id="formPromocao" novalidate
                      asp-action="@(editando ? "Editar" : "Nova")" asp-route-id="@Model.Id">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label"></label>
                        <input asp-for="Nome" class="form-control" maxlength="100" required />
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label asp-for="Tipo" class="form-label"></label>
                            <select asp-for="Tipo" class="form-select">
                                <option value="@TiposPromocao.Percentual">Percentual (%)</option>
                                <option value="@TiposPromocao.ValorFixo">Valor fixo (R$)</option>
                                <option value="@TiposPromocao.FreteGratis">Frete grátis</option>
                            </select>
                            <span asp-validation-for="Tipo" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6" id="grupoValor">
                            <label asp-for="Valor" class="form-label" id="rotuloValor"></label>
                            <input asp-for="Valor" class="form-control" type="number" step="0.01" min="0" max="99999.99" />
                            <span asp-validation-for="Valor" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mt-0">
                        <div class="col-sm-6" id="grupoPizza">
                            <label asp-for="PizzaId" class="form-label"></label>
                            <select asp-for="PizzaId" class="form-select">
                                <option value="">Pedido todo</option>
                                @foreach (var p in Model.Pizzas)
                                {
                                    <option value="@p.Id" selected="@(Model.PizzaId == p.Id)">@p.Nome@(p.Ativa ? "" : " (desativada)")</option>
                                }
                            </select>
                            <div class="form-text">Escolha uma pizza para o desconto valer só para ela.</div>
                        </div>
                        <div class="col-sm-6" id="grupoMinimo">
                            <label asp-for="ValorMinimo" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">R$</span>
                                <input asp-for="ValorMinimo" class="form-control" type="number" step="0.01" min="0" max="99999.99" />
                            </div>
                            <div class="form-text">Opcional. Só para promoções do pedido todo.</div>
                            <span asp-validation-for="ValorMinimo" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mt-0">
                        <div class="col-sm-6">
                            <label asp-for="Inicio" class="form-label"></label>
                            <input asp-for="Inicio" class="form-control" type="datetime-local"
                                   value="@(Model.Inicio is { } i ? Formatos.CampoDataHora(i) : "")" required />
                            <span asp-validation-for="Inicio" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Fim" class="form-label"></label>
                            <input asp-for="Fim" class="form-control" type="datetime-local"
                                   value="@(Model.Fim is { } f ? Formatos.CampoDataHora(f) : "")" required />
                            <span asp-validation-for="Fim" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-check mt-3">
                        <input asp-for="Ativa" class="form-check-input" />
                        <label asp-for="Ativa" class="form-check-label"></label>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-lavai">Salvar promoção</button>
                        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-5 mt-4 mt-lg-0">
        <div class="card shadow-sm">
            <div class="card-body small text-secondary">
                <h2 class="h6 text-body">Como as promoções funcionam</h2>
                <ul class="mb-0">
                    <li>Promoção de uma pizza reduz o preço dela no cardápio e no carrinho (vale a que mais desconta).</li>
                    <li>Promoção do pedido todo incide sobre o valor já reduzido pelas promoções de pizza.</li>
                    <li>Frete grátis zera a taxa de entrega e vale para o pedido todo.</li>
                    <li>O valor mínimo é comparado com o subtotal do pedido antes de qualquer desconto.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/admin/promocoes.js" asp-append-version="true"></script>
}
